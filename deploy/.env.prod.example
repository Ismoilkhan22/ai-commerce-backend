# Production — compose o'zgaruvchilari (namuna). VPS'da: cp deploy/.env.prod.example deploy/.env.prod && chmod 600 deploy/.env.prod
# Ilova sozlamalari alohida faylda: deploy/app.env (app.env.example) — superuser paroli ilova konteyneriga tushmasin.
# Ikkalasi ham hech qachon commit qilinmaydi (.gitignore). Tasodifiy kalit: openssl rand -base64 48
# Batafsil: docs/engineering/progress/M08-deploy.md
#
# ── Compose o'zgaruvchilari (docker compose --env-file deploy/.env.prod) ──────────────────────────────
PLATFORM_DOMAIN=platforma.uz
BACKEND_TAG=CHANGE_ME_git_sha            # git rev-parse --short HEAD (backend)
FRONTEND_TAG=CHANGE_ME_git_sha           # git rev-parse --short HEAD (frontend)
# BACKEND_DIR=..                         # compose fayliga nisbatan; standart — shu repo
# FRONTEND_DIR=../../ai-commerce-frontend
POSTGRES_PASSWORD=CHANGE_ME_long_random  # postgres superuser — faqat migrate (bootstrap) va backup
API_WORKERS=2
BACKUP_HOST_DIR=/var/backups/commerce-os
BACKUP_RETENTION_DAYS=14
# BACKUP_HEARTBEAT_URL=https://hc-ping.com/<uuid>   # backup muvaffaqiyatli bo'lsa signal (ixtiyoriy)
# FRONTEND_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>   # build vaqtida JS'ga yoziladi
# STOREFRONT_ASSET_ORIGINS=                         # CDN ishlatilsa
