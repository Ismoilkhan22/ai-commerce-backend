# Production — backend ilova sozlamalari (namuna). VPS'da: cp deploy/app.env.example deploy/app.env && chmod 600 deploy/app.env
# api, worker'lar va migrate shu faylni o'qiydi (docker-compose.prod.yml env_file). Tasodifiy kalit: openssl rand -base64 48
# Batafsil: docs/engineering/progress/M08-deploy.md

APP_ENV=production
LOG_LEVEL=INFO

# PostgreSQL rollari (ADR-035): parollar kamida 12 belgi, tasodifiy. migrate bootstrap shu parollar bilan yaratadi
DATABASE_URL=postgresql+asyncpg://app_runtime:CHANGE_ME_runtime_pw@postgres:5432/commerce_os
DATABASE_MIGRATOR_URL=postgresql+asyncpg://app_migrator:CHANGE_ME_migrator_pw@postgres:5432/commerce_os

REDIS_URL=redis://redis:6379/0
ARQ_REDIS_URL=redis://redis:6379/1
REALTIME_REDIS_URL=redis://redis:6379/2
RATE_LIMIT_BACKEND=redis

# Manzillar
APP_PUBLIC_URL=https://panel.platforma.uz
PLATFORM_APP_PUBLIC_URL=https://admin.platforma.uz
CORS_ORIGINS=["https://panel.platforma.uz","https://admin.platforma.uz"]
STOREFRONT_PUBLIC_URL=https://{slug}.platforma.uz
STOREFRONT_CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.platforma\.uz$
MESSAGING_WEBHOOK_BASE_URL=https://api.platforma.uz
PUBLIC_FILES_URL=https://api.platforma.uz/api/v1/public/files
COOKIE_SECURE=true

# Mijoz IP'si: X-Forwarded-For faqat nginx (172.30.0.10) va shop sayti serveri (172.30.0.20) dan qabul qilinadi.
# IP'lar docker-compose.prod.yml'da qat'iy. Shop sayti tomonida STOREFRONT_TRUSTED_PROXY_HOPS=1 (compose'da)
TRUSTED_PROXIES=["172.30.0.10","172.30.0.20"]

# Maxfiy kalitlar — har biri alohida, tasodifiy (openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_min_32_chars
IDEMPOTENCY_HASH_KEY=CHANGE_ME_min_32_chars
# Xaridor PII shifrlash (26 §4): "id:base64(32 bayt)". Yaratish: echo "p1:$(openssl rand -base64 32)"
PII_ENCRYPTION_KEYS=p1:CHANGE_ME_base64_32_bytes
PII_ACTIVE_KEY_ID=p1
PII_HMAC_KEY=CHANGE_ME_base64_32_bytes   # openssl rand -base64 32

# Fayllar: S3-mos ombor (O'zbekistonda, DEC-013). Bo'sh qoldirilsa STORAGE_BACKEND=local — `storage` volume
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://s3.example.uz
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_PRIVATE_BUCKET=cos-private
# S3_PUBLIC_BUCKET=cos-public            # ixtiyoriy: mahsulot rasmlari alohida bucket'da
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# Kanallar
TELEGRAM_MODE=webhook
# PLATFORM_TELEGRAM_BOT_TOKEN=
# PLATFORM_TELEGRAM_BOT_USERNAME=
# PLATFORM_TELEGRAM_WEBHOOK_SECRET=      # openssl rand -hex 32
FEATURE_CHANNEL_INSTAGRAM_DM=false

# AI sotuvchi. Production'da Gemini faqat pullik tarif (A14). Kalitsiz: LLM_PROVIDER=fake (AI "sozlanmagan")
LLM_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME
GEMINI_TIER=paid
GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=

# Kuzatuv (09 §9): bo'sh — Sentry o'chiq
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_TRACES_SAMPLE_RATE=0
