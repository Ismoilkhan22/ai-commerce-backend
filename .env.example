# Faqat lokal qiymatlar. Haqiqiy kalitlar hech qachon commit qilinmaydi (23 §3).
APP_ENV=local

# PostgreSQL (deploy/docker-compose.yml)
# app_runtime — NOBYPASSRLS, faqat DML; app_migrator — DDL (ADR-035, S0-03)
DATABASE_URL=postgresql+asyncpg://app_runtime:app_runtime@localhost:5432/commerce_os
DATABASE_MIGRATOR_URL=postgresql+asyncpg://app_migrator:app_migrator@localhost:5432/commerce_os
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/commerce_os

# Redis: db0 kesh/rate limit, db1 arq, db2 pub/sub (06, 08)
REDIS_URL=redis://localhost:6379

# MinIO (S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=commerce-os-local

# Tashqi servislar lokalda — fake adapterlar
LLM_PROVIDER=fake
CHANNEL_MODE=fake
