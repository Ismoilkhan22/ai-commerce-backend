# Faqat lokal qiymatlar. Haqiqiy kalitlar hech qachon commit qilinmaydi (23 §3).
APP_ENV=local

# PostgreSQL (deploy/docker-compose.yml)
# app_runtime — NOBYPASSRLS, faqat DML; app_migrator — DDL (ADR-035, S0-03)
DATABASE_URL=postgresql+asyncpg://app_runtime:app_runtime@localhost:5433/commerce_os
DATABASE_MIGRATOR_URL=postgresql+asyncpg://app_migrator:app_migrator@localhost:5433/commerce_os
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/commerce_os

# Redis: db0 kesh/rate limit, db1 arq, db2 pub/sub (06, 08)
REDIS_URL=redis://localhost:6380

# Fayllar (S0-08): lokalda disk. S3-mos ombor adapteri deploy bilan (S0-10, TD-03)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/storage
PUBLIC_FILES_URL=http://localhost:8000/api/v1/public/files

# Tashqi servislar lokalda — fake adapterlar
LLM_PROVIDER=fake
CHANNEL_MODE=fake

# Auth (ADR-023). Production'da: kamida 32 belgili tasodifiy kalit, cookie_secure=true
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
APP_PUBLIC_URL=http://localhost:3000
PLATFORM_APP_PUBLIC_URL=http://localhost:3001
COOKIE_SECURE=false
# Xaridor telefoni va manzili shifrlash (26 §4): "id:base64(32 bayt)", vergul bilan bir nechta kalit (rotatsiya).
# Faqat lokal qiymatlar — staging/production'da rad etiladi; u yerda secret manager'dan.
PII_ENCRYPTION_KEYS=dev1:ZGV2LW9ubHktcGlpLWtleS1jaGFuZ2UtbWUtMDAwMDA=
PII_ACTIVE_KEY_ID=dev1
PII_HMAC_KEY=ZGV2LW9ubHktcGlpLWhtYWMta2V5LWNoYW5nZS1tZSE=
# 3000 — shop paneli, 3001 — platforma paneli
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
RATE_LIMIT_BACKEND=redis
# RATE_LIMIT_MEMORY_SCALE=1     # faqat memory backend: limitlar ko'paytmasi (e2e: 10)
