# Faqat lokal qiymatlar. Haqiqiy kalitlar hech qachon commit qilinmaydi (23 §3).
APP_ENV=local

# PostgreSQL (deploy/docker-compose.yml)
# app_runtime — NOBYPASSRLS, faqat DML; app_migrator — DDL (ADR-035, S0-03)
DATABASE_URL=postgresql+asyncpg://app_runtime:app_runtime@localhost:5433/commerce_os
DATABASE_MIGRATOR_URL=postgresql+asyncpg://app_migrator:app_migrator@localhost:5433/commerce_os
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/commerce_os

# Redis: db0 kesh/rate limit, db1 arq, db2 pub/sub (06, 08)
REDIS_URL=redis://localhost:6380
# Fon ishlari navbati (arq) — db1; realtime (WebSocket ticket, signal) — db2 (06 §4.1, 08 §3)
ARQ_REDIS_URL=redis://localhost:6380/1
REALTIME_REDIS_URL=redis://localhost:6380/2
# REALTIME_HEARTBEAT_SECONDS=25
# Platforma boti — xodimga Telegram xabari (DEC-129). Bo'sh: xabar yuborilmaydi (faqat log), webhook o'chiq
# PLATFORM_TELEGRAM_BOT_TOKEN=
# PLATFORM_TELEGRAM_BOT_USERNAME=
# PLATFORM_TELEGRAM_WEBHOOK_SECRET=
# Shop botlari (5b): lokalda standart "polling" (make worker getUpdates bilan so'raydi), boshqa muhitda "webhook"
# TELEGRAM_MODE=polling
# Webhook manzili asosi (production'da ochiq HTTPS API manzili; lokal manzil rad etiladi)
# MESSAGING_WEBHOOK_BASE_URL=http://localhost:8000
# Instagram Direct — flag ostida (DEC-116a). O'chiq bo'lsa Instagram endpointlari 404
# FEATURE_CHANNEL_INSTAGRAM_DM=false
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_VERIFY_TOKEN=

# Fayllar (S0-08): lokalda disk. Production'da S3-mos ombor — STORAGE_BACKEND=s3 (S0-10, deploy/app.env.example)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/storage
# S3_ENDPOINT_URL=  S3_REGION=us-east-1  S3_ACCESS_KEY_ID=  S3_SECRET_ACCESS_KEY=
# S3_PRIVATE_BUCKET=  S3_PUBLIC_BUCKET=  S3_FORCE_PATH_STYLE=true
PUBLIC_FILES_URL=http://localhost:8000/api/v1/public/files

# Shop sayti (4-modul): manzil shop slug'i bilan (prod: https://{slug}.platforma.uz); sayt brauzerdan
# ommaviy API'ni cookie'siz chaqiradi — CORS faqat shu manzillarga
STOREFRONT_PUBLIC_URL=http://{slug}.localhost:3002
STOREFRONT_CORS_ORIGIN_REGEX=^http://([a-z0-9-]+\.)?localhost:3002$
# Sayt serverining o'zi (SSR, xaridor IP'sisiz) uchun shop bo'yicha o'qish limiti, daqiqasiga
STOREFRONT_SSR_READ_LIMIT_PER_MINUTE=3000

# Tashqi servislar lokalda — fake adapterlar
CHANNEL_MODE=fake

# AI sotuvchi (6b). fake — kalitsiz demo (sinov oynasi ishlaydi). Gemini bilan sinash:
#   LLM_PROVIDER=gemini va GEMINI_API_KEY=<Google AI Studio kaliti>, keyin backend va worker'ni qayta ishga tushiring.
#   Bepul kalit (GEMINI_TIER=free) — faqat sintetik/demo ma'lumot bilan (Google o'rganishi mumkin, A14).
# Claude: LLM_PROVIDER=anthropic va ANTHROPIC_API_KEY=... (no-training/ZDR shartli hisob).
LLM_PROVIDER=fake
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIER=free
# ANTHROPIC_API_KEY=
# AI_DEBOUNCE_SECONDS=2.5

# Auth (ADR-023). Production'da: kamida 32 belgili tasodifiy kalit, cookie_secure=true
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
APP_PUBLIC_URL=http://localhost:3000
PLATFORM_APP_PUBLIC_URL=http://localhost:3001
COOKIE_SECURE=false
# Xaridor telefoni va manzili shifrlash (26 §4): "id:base64(32 bayt)", vergul bilan bir nechta kalit (rotatsiya).
# Faqat lokal qiymatlar — staging/production'da rad etiladi; u yerda secret manager'dan.
PII_ENCRYPTION_KEYS=dev1:ZGV2LW9ubHktcGlpLWtleS1jaGFuZ2UtbWUtMDAwMDA=
PII_ACTIVE_KEY_ID=dev1
PII_HMAC_KEY=ZGV2LW9ubHktcGlpLWhtYWMta2V5LWNoYW5nZS1tZSE=
# Takroriy so'rov jadvalidagi barmoq izi kaliti (HMAC). Prod'da: kamida 32 belgili tasodifiy kalit
IDEMPOTENCY_HASH_KEY=dev-only-idempotency-hash-key-change-me
# 3000 — shop paneli, 3001 — platforma paneli
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
RATE_LIMIT_BACKEND=redis
# Rate limit uchun mijoz IP'si: X-Forwarded-For faqat shu manzillardan (IP/CIDR) qabul qilinadi.
# Lokal: o'z kompyuteri (shop sayti SSR serveri ham shu yerda; XFF'ni lokalda soxtalash mumkin — ataylab).
# Prod: Nginx va shop sayti serverining ichki manzili, masalan ["10.0.1.10","10.0.1.20"] (22 §8)
TRUSTED_PROXIES=["127.0.0.1","::1"]
# RATE_LIMIT_SCALE=1            # limitlar ko'paytmasi (Redis va xotira), faqat local/test; e2e: 10

# Kuzatuv (09, S0-05): bo'sh — Sentry o'chiq. SERVICE_NAME/APP_VERSION — deploy beradi (logdagi service, version)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
