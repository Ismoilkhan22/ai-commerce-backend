// =====================================================================
// AI Commerce OS — `platform` schemasi: Shop va xodimlar (1-funksiya)
// Holat: TASDIQLANGAN (DEC-131) va 1-modulda kodga tushgan (2026-10-23, migratsiya platform_0004)
// Ko‘rish: https://dbdiagram.io → shu faylni to‘liq nusxalab qo‘ying
// Manba hujjatlar: engineering/07 §4.1, engineering/10, business/04, business/05 (FSM-01)
// =====================================================================

Project ai_commerce_os {
  database_type: 'PostgreSQL'
  Note: '''
  **Umumiy qoidalar (07 §2):**
  - id — UUIDv7 (vaqt bo‘yicha tartiblangan), ilovada yaratiladi.
  - Shopga tegishli har jadvalda `shop_id NOT NULL`; boshqa shop obyektiga bog‘lab bo‘lmasligi uchun FK’lar (shop_id, id) juftligi bilan.
  - Holatlar — TEXT + CHECK (UPPER_SNAKE). Diagrammada Enum sifatida ko‘rsatilgan.
  - Vaqt — timestamptz (UTC).
  - Biznes obyektlari o‘chirilmaydi — holati o‘zgaradi (DISABLED, CLOSED, ARCHIVED).
  - version — bir vaqtda ikki kishi o‘zgartirsa, ikkinchisi "VERSION_CONFLICT" oladi.
  '''
}

// ---------------------------------------------------------------------
// Holatlar (enum)
// ---------------------------------------------------------------------

Enum platform.shop_status {
  DRAFT [note: 'Platforma yaratdi, hali sozlanmoqda']
  PENDING_VERIFICATION [note: 'Sozlash tugadi, platforma tekshiruvida']
  ACTIVE [note: 'Ishlayapti: sayt ochiq, AI javob beradi']
  SUSPENDED [note: 'To‘xtatilgan: yangi buyurtma yo‘q, eski buyurtmalar yakunlanadi']
  CLOSED [note: 'Yopilgan']
}

Enum platform.branch_status {
  ACTIVE
  CLOSED [note: 'Olib ketish joyi sifatida tanlab bo‘lmaydi (UAT-M03)']
}

Enum platform.principal_status {
  ACTIVE
  BLOCKED [note: 'Platforma bloklagan — hech qaysi shopga kira olmaydi']
}

Enum platform.membership_status {
  INVITED [note: 'Taklif yuborilgan, hali qabul qilinmagan']
  ACTIVE
  DISABLED [note: 'O‘chirilgan — sessiyalari darhol bekor qilinadi (TC-025)']
}

Enum platform.role {
  OWNER [note: 'Ega — hamma narsa, shu jumladan sozlamalar, xodimlar, AI']
  MANAGER [note: 'Menejer — tasdiqlashlar, katalog, narx, filial doirasida']
  SALES [note: 'Operator — suhbatlar, o‘ziniki buyurtmalar, tez sotuv']
  WAREHOUSE [note: 'Omborchi — kirim, tuzatish so‘rovi, tez sotuv']
  // Moliya, katalog xodimi, tahlilchi, AI muharriri — keyinroq (DEC-131)
}

Enum platform.branch_scope {
  ALL [note: 'Barcha filiallar']
  SELECTED [note: 'Faqat membership_branches dagi filiallar']
}

Enum platform.platform_role {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
  SPEC_EDITOR [note: 'PC texnik ma’lumotlar kutubxonasini yuritadi (DEC-120)']
}

// ---------------------------------------------------------------------
// Shop va filiallar
// ---------------------------------------------------------------------

Table platform.shops {
  id uuid [pk]
  slug text [not null, unique, note: 'Sayt manzili: {slug}.platforma.uz. Kichik harf, raqam, chiziqcha']
  name text [not null, note: 'Ko‘rinadigan nomi']
  legal_name text [note: 'Yuridik nomi (shartnoma uchun)']
  tin text [not null, unique, note: 'STIR — majburiy (founder, 2026-10-23). 9 raqam']
  status platform.shop_status [not null, default: 'DRAFT', note: 'FSM-01. Faqat platforma jamoasi faollashtiradi (DEC-122)']
  default_locale text [not null, default: 'uz', note: 'uz | ru | en']
  timezone text [not null, default: 'Asia/Tashkent', note: 'Hisobot kunlari shu bo‘yicha']
  deployment_mode text [not null, default: 'SHARED', note: 'SHARED | DEDICATED (DEC-001)']
  activated_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  version bigint [not null, default: 1]

  Note: '''
  Tenant — platformadan foydalanadigan do‘kon. Bu jadvalda shop_id yo‘q: id’ning o‘zi tenant.
  Qoidalar: BL-001…BL-004. Holatlar: business/05 "Shop akkaunti".
  '''
}

Table platform.branches {
  id uuid [pk]
  shop_id uuid [not null]
  name text [not null]
  address text [not null]
  phone text
  latitude numeric(9,6)
  longitude numeric(9,6)
  working_hours jsonb [not null, note: 'Hafta kunlari bo‘yicha: {"mon": [["10:00","20:00"]], ...}']
  is_pickup_point boolean [not null, default: true, note: 'Xaridor shu yerdan olib keta oladimi']
  status platform.branch_status [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  version bigint [not null, default: 1]

  indexes {
    (shop_id, id) [unique, note: 'Boshqa jadvallardagi (shop_id, branch_id) FK uchun']
    (shop_id, status)
  }
  Note: 'Shopning jismoniy joyi. Qoldiq filial bo‘yicha yuritiladi (M03, BL-009…BL-012).'
}

Table platform.shop_policies {
  shop_id uuid [pk, note: 'Har shopga bitta yozuv']
  quote_ttl_hours int [not null, default: 24, note: 'PC taklifi amal qilish muddati (DEC-103)']
  discount_limit_sales_pct numeric(5,2) [not null, default: 0, note: 'Operator chegirmasi limiti (DEC-110)']
  discount_limit_manager_pct numeric(5,2) [not null, default: 5, note: 'Menejer limiti; undan katta — ega']
  order_reminder_hours int[] [not null, default: '{24,72}', note: 'Tasdiqlanmagan buyurtma eslatmalari (DEC-104)']
  quote_approval_mode text [not null, default: 'ALL', note: 'ALL | RISKY_ONLY (DEC-102)']
  exchange_rate_source text [not null, default: 'MANUAL', note: 'MANUAL | CBU (DEC-121)']
  stock_display text [not null, default: 'STATUS_ONLY', note: 'EXACT | STATUS_ONLY (DEC-128)']
  low_stock_threshold int [not null, default: 2, note: '"Kam qoldi" chegarasi']
  updated_at timestamptz [not null, default: `now()`]
  version bigint [not null, default: 1]

  Note: 'Shop sozlamalari. Faqat ega o‘zgartiradi (shops.policy.edit).'
}

// ---------------------------------------------------------------------
// Foydalanuvchilar va a’zolik
// ---------------------------------------------------------------------

Table platform.principals {
  id uuid [pk]
  phone text [not null, unique, note: 'E.164 formatda (+998901234567). Login uchun asosiy; taklif shu raqamga beriladi']
  email text [unique, note: 'Ixtiyoriy']
  full_name text [not null]
  password_hash text [note: 'Argon2id. Taklifni qabul qilguncha NULL']
  locale text [not null, default: 'uz', note: 'Interfeys tili']
  status platform.principal_status [not null, default: 'ACTIVE']
  phone_verified_at timestamptz [note: 'Telefon tasdiqlangan vaqt (taklifni qabul qilganda)']
  failed_login_attempts int [not null, default: 0, note: 'Ketma-ket xato parollar']
  locked_until timestamptz [note: 'Masalan, 5 xatodan keyin 15 daqiqa bloklanadi']
  password_changed_at timestamptz [note: 'Parol o‘zgarsa, undan oldingi sessiyalar bekor']
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  version bigint [not null, default: 1]

  Note: '''
  Tizimga kiradigan odam. Shopga bog‘liq emas: shop bilan a’zolik orqali bog‘lanadi (hozircha bitta shop, DEC-131). Platforma jamoasi ham shu jadvaldan kiradi.
  Shaxsiy ma’lumot — logga va event’larga tushmaydi.
  '''
}

Table platform.memberships {
  id uuid [pk]
  shop_id uuid [not null]
  principal_id uuid [not null]
  role platform.role [not null, note: 'Bitta xodim — bitta rol (DEC-131)']
  status platform.membership_status [not null, default: 'INVITED']
  branch_scope platform.branch_scope [not null, default: 'ALL']
  invited_by uuid [note: 'Taklif qilgan a’zolik (memberships.id)']
  activated_at timestamptz
  disabled_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  version bigint [not null, default: 1]

  indexes {
    principal_id [unique, note: 'Hozircha bir odam faqat bitta shopda ishlaydi (founder, 2026-10-23). Keyin kerak bo‘lsa shu cheklov olib tashlanadi']
    (shop_id, principal_id) [unique, note: 'Bir odam bir shopda bitta a’zolik']
    (shop_id, id) [unique]
  }
  Note: '''
  Odam ↔ shop bog‘lanishi: shu shopda kim, qaysi holatda, qaysi filiallar doirasida.
  Oxirgi ACTIVE OWNER’ni o‘chirib yoki rolini o‘zgartirib bo‘lmaydi (LAST_OWNER_REQUIRED) — ilova va trigger bilan.
  Rol → ruxsatlar ro‘yxati bazada emas, kodda (app/platform/staff/permissions.py, DEC-131).
  RLS (FORCE): faqat joriy shop a’zoliklari YOKI odamning o‘z a’zoligi ko‘rinadi — login paytida shop hali noma’lum (engineering/10 §4).
  Trigger trg_memberships_last_owner: oxirgi egani o‘chirish/rolini almashtirish bazada ham to‘xtatiladi (parallel so‘rovlarda ham).
  '''
}

Table platform.membership_branches {
  shop_id uuid [not null]
  membership_id uuid [not null]
  branch_id uuid [not null]

  indexes {
    (membership_id, branch_id) [pk]
  }
  Note: 'Faqat branch_scope = SELECTED bo‘lsa ishlatiladi.'
}

Table platform.invitations {
  id uuid [pk]
  shop_id uuid [not null]
  membership_id uuid [not null, note: 'Taklif — INVITED a’zolik; parol tiklash — ACTIVE a’zolik']
  purpose text [not null, note: 'INVITE (xodim taklifi, 72 soat) | PASSWORD_RESET (parol tiklash, 24 soat)']
  token_hash text [not null, unique, note: 'Havola tokenining hash’i; tokenning o‘zi saqlanmaydi']
  channel text [not null, default: 'LINK', note: 'Hozir faqat LINK — ega havolani o‘zi yuboradi (DEC-131). Keyin SMS | TELEGRAM']
  expires_at timestamptz [not null, note: 'Masalan 72 soat']
  accepted_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, membership_id)
  }
  Note: 'Bir martalik havolalar: xodim taklifi va parolni tiklash. Qayta berilsa — yangi yozuv, oldingi ochiq havolalar revoked. Havolaning o‘zi hech qayerda saqlanmaydi (idempotency javobida ham).'
}

Table platform.sessions {
  id uuid [pk]
  principal_id uuid [not null]
  shop_id uuid [note: 'Xodimning shopi; platforma xodimi uchun NULL']
  audience text [not null, note: 'shop | platform — qaysi panel uchun. Shop paneli tokeni platforma panelida ishlamaydi']
  family_id uuid [not null, note: 'Refresh token zanjiri. O‘g‘irlangan token qayta ishlatilsa — butun zanjir bekor (ADR-023)']
  refresh_token_hash text [not null, unique]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  revoked_reason text [note: 'LOGOUT | ROTATED | REUSE_DETECTED | MEMBERSHIP_DISABLED | ...']
  user_agent text
  created_at timestamptz [not null, default: `now()`]
  last_used_at timestamptz

  indexes {
    (principal_id, revoked_at)
    family_id
  }
  Note: 'Kirish sessiyalari. Access token (15 daq) bazaga yozilmaydi — faqat refresh token hash’i (30 kun, har ishlatilganda yangilanadi). RLS (FORCE): joriy shop YOKI o‘z sessiyalari.'
}

// ---------------------------------------------------------------------
// Platforma jamoasi
// ---------------------------------------------------------------------

Table platform.platform_staff {
  id uuid [pk]
  principal_id uuid [not null, unique]
  role platform.platform_role [not null]
  status text [not null, default: 'ACTIVE', note: 'INVITED | ACTIVE | DISABLED. Kodda (platform_0005): panel orqali taklif qilinganda INVITED']
  invited_by uuid [note: 'Kodda (platform_0005): kim taklif qilgan (platform_staff.id); CLI yoki seed bilan yaratilganda NULL']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Kodda (platform_0005)']
  version bigint [not null, default: 1, note: 'Kodda (platform_0005): rolni ikki admin bir vaqtda o‘zgartirsa — VERSION_CONFLICT']

  Note: 'Bizning jamoa. Shop ma’lumotini odatiy holatda ko‘rmaydi; faqat support grant bilan (keyinroq). Oxirgi faol PLATFORM_ADMIN’ni o‘chirib bo‘lmaydi.'
}

// Kodda (platform_0005, business/15 §5): platforma jamoasiga panel orqali taklif.
// Nega `invitations` ga qo‘shilmaydi: u shop a’zoligiga (shop_id, membership_id) bog‘langan va RLS ostida.
Table platform.platform_staff_invitations {
  id uuid [pk]
  platform_staff_id uuid [not null]
  purpose text [not null, note: 'INVITE | PASSWORD_RESET']
  token_hash text [not null, unique, note: 'Havolaning o‘zi saqlanmaydi']
  expires_at timestamptz [not null, note: 'Taklif 72 soat, tiklash 24 soat']
  accepted_at timestamptz
  revoked_at timestamptz
  created_by uuid [note: 'platform_staff.id']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    platform_staff_id
  }
  Note: 'Kodda (platform_0005). Shop xodimi taklifi bilan bir xil ishlaydi: bir martalik, muddatli, faqat oxirgisi amal qiladi.'
}

// Kodda (platform_0005, business/15 §3): platformaning ichki izohi — shop ko‘rmaydi.
Table platform.shop_notes {
  id uuid [pk]
  shop_id uuid [not null]
  author_id uuid [not null, note: 'platform_staff.id']
  body text [not null, note: 'Ko‘pi bilan 2000 belgi. Shaxsiy ma’lumot yozmaslik tavsiya qilinadi']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, created_at)
  }
  Note: 'Kodda (platform_0005). Faqat qo‘shiladi (tahrir yo‘q) — kim nima yozgani tarix bo‘lib qoladi. RLS’siz: faqat platforma panelidan o‘qiladi.'
}

// ---------------------------------------------------------------------
// Tayyor (S0-07 da qurilgan) — ko‘rib chiqish uchun
// ---------------------------------------------------------------------

Table platform.transition_log {
  id uuid [not null]
  occurred_at timestamptz [not null, default: `now()`]
  shop_id uuid
  entity_type text [not null, note: 'platform.shop, commerce.order, ...']
  entity_id uuid [not null]
  command text [not null, note: 'ACTIVATE, CONFIRM, ...']
  from_status text [not null]
  to_status text [not null]
  actor_type text [not null, note: 'STAFF | AI_AGENT | CUSTOMER | SYSTEM | PLATFORM']
  actor_id uuid
  reason text
  forced boolean [not null, default: false]
  trace_id text

  indexes {
    (id, occurred_at) [pk]
    (shop_id, entity_type, entity_id, occurred_at)
  }
  Note: 'Holat o‘tishlari jurnali. Faqat qo‘shiladi, o‘zgartirilmaydi. Oyma-oy bo‘lingan (partition). ✅ Kodda bor.'
}

Table platform.idempotency_keys {
  shop_id uuid [not null]
  operation text [not null, note: 'order.confirm, ...']
  key text [not null, note: 'Idempotency-Key header']
  request_hash text [not null]
  response_status int
  response_body jsonb
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null, note: '24 soat']

  indexes {
    (shop_id, operation, key) [pk]
    expires_at
  }
  Note: 'Takroriy so‘rov himoyasi. ✅ Kodda bor.'
}

// ---------------------------------------------------------------------
// Bog‘lanishlar
// ---------------------------------------------------------------------

Ref: platform.branches.shop_id > platform.shops.id [delete: restrict]
Ref: platform.shop_policies.shop_id - platform.shops.id [delete: restrict]

Ref: platform.memberships.shop_id > platform.shops.id [delete: restrict]
Ref: platform.memberships.principal_id > platform.principals.id [delete: restrict]
Ref: platform.memberships.invited_by > platform.memberships.id

// (shop_id, ...) juftligi — rol yoki filial boshqa shop a’zoligiga bog‘lanib qolmasin
Ref: platform.membership_branches.(shop_id, membership_id) > platform.memberships.(shop_id, id) [delete: cascade]
Ref: platform.membership_branches.(shop_id, branch_id) > platform.branches.(shop_id, id) [delete: restrict]
Ref: platform.invitations.(shop_id, membership_id) > platform.memberships.(shop_id, id) [delete: cascade]

Ref: platform.sessions.principal_id > platform.principals.id [delete: cascade]
Ref: platform.sessions.shop_id > platform.shops.id
Ref: platform.platform_staff.principal_id > platform.principals.id [delete: restrict]
// Kodda (platform_0005)
Ref: platform.platform_staff.invited_by > platform.platform_staff.id
Ref: platform.platform_staff_invitations.platform_staff_id > platform.platform_staff.id [delete: cascade]
Ref: platform.shop_notes.shop_id > platform.shops.id [delete: restrict]
Ref: platform.shop_notes.author_id > platform.platform_staff.id [delete: restrict]

// ---------------------------------------------------------------------
// Diagrammada guruhlash
// ---------------------------------------------------------------------

TableGroup shop_va_filiallar {
  platform.shops
  platform.branches
  platform.shop_policies
}

TableGroup foydalanuvchilar_va_rollar {
  platform.principals
  platform.memberships
  platform.membership_branches
  platform.invitations
  platform.sessions
}

TableGroup platforma_jamoasi {
  platform.platform_staff
  platform.platform_staff_invitations
  platform.shop_notes
}

TableGroup tayyor_texnik {
  platform.transition_log
  platform.idempotency_keys
}
