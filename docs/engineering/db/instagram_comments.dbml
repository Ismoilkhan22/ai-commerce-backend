// =====================================================================
// AI Commerce OS — `messaging` schemasiga qo'shimcha: Instagram izohlari (6+ modul, DEC-132)
// Holat: TAKLIF 2026-10-27 — qarorlar qabul qilingan (founder topshirig'i bilan), founder ko'rib chiqishi kutilmoqda.
//        Qarorlar: instagram_comments.md oxirida ("Founder ko'rib chiqishi uchun qarorlar").
// messaging.dbml O'ZGARTIRILMAYDI — bu fayl unga qo'shiladigan jadvallar; kichik ta'sirlar pastda.
// Yoqish: feature flag `channel.instagram_comments` (Meta ruxsati kelmaguncha o'chiq) — DEC-132, DEC-116a.
// Ko'rish: https://dbdiagram.io → shu faylni to'liq nusxalab qo'ying
// Izohlar: db/instagram_comments.md
// Manba hujjatlar: DEC-132; engineering/13 §2, §3, §7; db/messaging.md; business/03 BL-033, BL-036, BL-038, BL-039, BL-061;
//                  engineering/14 (redaction), 20; db/sales_ai.md §11 (ai_usage)
// =====================================================================

Project ai_commerce_os_instagram_comments {
  database_type: 'PostgreSQL'
  Note: '''
  **Umumiy qoidalar** — messaging.dbml bilan bir xil: UUIDv7, timestamptz, `shop_id NOT NULL`, (shop_id, id) composite FK,
  holatlar TEXT + CHECK, RLS ENABLE + FORCE.

  **Webhook** — o'sha `/webhooks/instagram/{account_ref}` va o'sha channel_accounts qatori (bitta Meta tokeni, scopes'da izohlar
  ruxsati). Dedup — messaging.provider_events (kind = COMMENT, allaqachon zaxirada).

  **Narx** faqat ig_post_products dagi katalog mahsulotidan, javob paytida CatalogQueryPort orqali (BL-038). AI narx aytmaydi.
  **«+» va narx so'rovi** — oddiy qoida (kodda), AI emas. **Kayfiyat** — AI (COMMENT_CLASSIFY), odam tuzata oladi.
  **Shaxsiy ma'lumot:** izoh matni — messages.body kabi at rest, 12 oy; tashqi AI'ga telefon/manzil yashirilib yuboriladi (BL-039).
  Event'larda matn va username yo'q.

  **Standart texnik jadvallar:** messaging.outbox_events, messaging.consumer_receipts (jobs.dbml).
  '''
}

// ---------------------------------------------------------------------
// Holatlar (enum)
// ---------------------------------------------------------------------

Enum messaging.ig_comment_trigger {
  PLUS [note: 'Izoh «+» (yoki "+", "++", "+1") — oddiy qoida']
  PRICE_QUESTION [note: 'Narx so\'rovi kalit so\'zlari: narx, qancha, нарх, цена, сколько, price … (uz/ru/en, lotin/kirill)']
  NONE [note: 'Avtomatik javob kerak emas — faqat kayfiyat']
}

Enum messaging.ig_comment_status {
  RECEIVED [note: 'Saqlandi, qoida tekshirildi']
  CLASSIFIED [note: 'Kayfiyat aniqlandi (AI yoki xodim)']
  CLASSIFY_SKIPPED [note: 'Kayfiyat tahlili o\'chiq / AI limiti tugagan / matnsiz izoh']
  DELETED [note: 'Muallif yoki shop izohni o\'chirdi (webhook) — matn tozalanadi']
}

Enum messaging.ig_sentiment {
  POSITIVE [note: 'Ijobiy']
  NEGATIVE [note: 'Salbiy → menejerga vazifa + javob qoralamasi']
  NEUTRAL [note: 'Neytral (savol, ma\'lumot)']
  SPAM [note: 'Spam, reklama, bot']
  UNDETERMINED [note: 'Ishonch past (< chegara) yoki aralash — "aniqlanmagan"']
}

Enum messaging.ig_sentiment_source {
  AI [note: 'AI bahosi — hisobotda shunday belgilanadi']
  STAFF [note: 'Xodim tuzatdi — AI bahosidan ustun']
}

Enum messaging.ig_reply_kind {
  PRIVATE_AUTO [note: 'Direct\'ga avtomatik javob (Private Reply) — «+» yoki narx so\'rovi']
  PRIVATE_STAFF [note: 'Direct\'ga xodim javobi (Private Reply)']
  PUBLIC_STAFF [note: 'Izoh ostida ommaviy javob — faqat xodim, AI qoralamasi bo\'lishi mumkin']
}

Enum messaging.ig_reply_status {
  DRAFT [note: 'AI qoralamasi — salbiy izohga, menejer ko\'rib chiqadi (DEC-132)']
  QUEUED [note: 'Yuborish navbatida (channel_send vazifasi)']
  SENDING
  SENT [note: 'Meta qabul qildi']
  FAILED [note: 'Yakuniy xato — kod bilan, xodim ko\'radi']
  SKIPPED [note: 'Yuborilmadi: skip_reason bilan']
  DISCARDED [note: 'Qoralama rad etildi / eskirdi']
}

// ---------------------------------------------------------------------
// Mavjud jadval — faqat bog'lanishni ko'rsatish uchun (to'liq ta'rif messaging.dbml da)
// ---------------------------------------------------------------------

Table messaging.channel_accounts {
  id uuid [pk]
  shop_id uuid [not null]
  Note: 'messaging.dbml dagi jadval. settings.comments = {auto_reply: true, sentiment: true} qo\'shiladi (PII yo\'q)'
}

// ---------------------------------------------------------------------
// Postlar
// ---------------------------------------------------------------------

Table messaging.ig_posts {
  id uuid [pk]
  shop_id uuid [not null]
  channel_account_id uuid [not null]
  external_media_id text [not null, note: 'Instagram media id']
  media_type text [note: 'IMAGE | VIDEO | CAROUSEL_ALBUM | REELS']
  permalink text [note: 'Post havolasi — panelda ochish uchun']
  caption_excerpt text [note: 'Izohning birinchi 200 belgisi — panelda postni tanish uchun']
  thumbnail_url text [note: 'Meta CDN havolasi, eskiradi — faqat ko\'rsatish, saqlanmaydi']
  posted_at timestamptz
  auto_reply_enabled boolean [not null, default: true, note: 'Shop konkurs postlarida o\'chiradi (DEC-132)']
  auto_reply_disabled_by uuid
  fetched_at timestamptz [note: 'Media ma\'lumoti Meta\'dan olingan vaqt (birinchi izohda, arq vazifasi)']
  comment_count int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  version bigint [not null, default: 1]

  indexes {
    (shop_id, id) [unique]
    (shop_id, channel_account_id, external_media_id) [unique]
    (shop_id, posted_at)
  }
  Note: '''
  Shop posti — birinchi izoh kelganda yaratiladi, media ma'lumoti arq vazifasida olinadi (webhook ichida emas).
  Hamma postni oldindan import qilinmaydi. RLS (FORCE).
  '''
}

Table messaging.ig_post_products {
  shop_id uuid [not null]
  post_id uuid [not null]
  product_id uuid [not null, note: 'catalog.products.id — FK\'siz']
  sku_id uuid [note: 'catalog.skus.id — aniq variant (ixtiyoriy). Bo\'sh bo\'lsa mahsulotning eng arzon sotuvdagi varianti']
  position int [not null, default: 0]
  linked_by uuid [not null, note: 'platform.memberships.id — faqat xodim bog\'laydi, AI rasmdan taxmin qilmaydi (DEC-132)']
  linked_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, post_id, product_id) [pk]
  }
  Note: 'Post ↔ katalog mahsuloti. Ko\'pi bilan 5 ta (karusel). Narxli javob faqat shu bog\'lanish bo\'lsa. RLS (FORCE).'
}

// ---------------------------------------------------------------------
// Izohlar va kayfiyat
// ---------------------------------------------------------------------

Table messaging.ig_comments {
  id uuid [pk]
  shop_id uuid [not null]
  channel_account_id uuid [not null]
  post_id uuid [not null]
  external_comment_id text [not null, note: 'Meta comment id — Private Reply shu id\'ga yuboriladi']
  parent_external_comment_id text [note: 'Izohga javob (thread) bo\'lsa — ota izoh']
  author_external_id text [not null, note: 'Izoh muallifining IG id\'si (from.id)']
  author_username text [note: 'PII — @taxallus. Panelda ko\'rsatiladi, event va hisobotga tushmaydi']
  is_own_account boolean [not null, default: false, note: 'Shopning o\'z izohi — qayta ishlanmaydi']
  body text [note: 'Izoh matni — at rest (26 §4), 12 oy. DELETED da tozalanadi']
  commented_at timestamptz [not null, note: 'Meta vaqti — 7 kunlik Private Reply oynasi shundan']
  status messaging.ig_comment_status [not null, default: 'RECEIVED']
  trigger messaging.ig_comment_trigger [not null, default: 'NONE']
  sentiment messaging.ig_sentiment [note: 'Joriy kayfiyat (oxirgi ig_comment_sentiments qatori)']
  sentiment_source messaging.ig_sentiment_source
  sentiment_id uuid [note: 'Joriy ig_comment_sentiments.id']
  conversation_id uuid [note: 'Xaridor Direct\'da javob yozsa — bog\'langan messaging.conversations.id']
  customer_identity_id uuid [note: 'Shu suhbatning xaridori (Direct javobidan keyin ma\'lum bo\'ladi)']
  provider_event_id text [note: 'Dedup kaliti nusxasi (provider_events)']
  deleted_at timestamptz
  pii_erased_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  version bigint [not null, default: 1]

  indexes {
    (shop_id, id) [unique]
    (shop_id, channel_account_id, external_comment_id) [unique, note: 'Bir izoh — bir qator (takror webhook)']
    (shop_id, post_id, commented_at)
    (shop_id, sentiment, commented_at) [note: '"Salbiy izohlar" ro\'yxati']
    (shop_id, author_external_id, post_id) [note: 'Bir muallifga bir postda bitta avtomatik javob']
    (shop_id, commented_at) [note: '12 oylik tozalash']
  }
  Note: '''
  Post ostidagi izoh. Webhook: provider_events (COMMENT) → shu qator → qoida (trigger) → outbox messaging.ig_comment.received.
  Keyin arq vazifalari: kayfiyat (AI) va avtomatik javob — ikkalasi mustaqil, bir-birini kutmaydi.
  RLS (FORCE).
  '''
}

Table messaging.ig_comment_sentiments {
  id uuid [pk]
  shop_id uuid [not null]
  comment_id uuid [not null]
  source messaging.ig_sentiment_source [not null]
  sentiment messaging.ig_sentiment [not null]
  confidence numeric(4,3) [note: 'AI: 0…1. Chegara (0.70) dan past → UNDETERMINED yoziladi, asl taxmin raw_label da']
  raw_label text [note: 'AI asl javobi (chegara qo\'llanmasdan oldin)']
  language text [note: 'uz-Latn | uz-Cyrl | ru | en | mixed — sifat tahlili uchun']
  model_id text
  prompt_version text
  ai_usage_id uuid [note: 'platform.ai_usage.id (purpose COMMENT_CLASSIFY)']
  staff_membership_id uuid [note: 'STAFF bo\'lsa — kim tuzatdi']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, id) [unique]
    (shop_id, comment_id, created_at)
  }
  Note: '''
  Kayfiyat tarixi: AI bahosi va xodim tuzatishlari. Faqat qo'shiladi. Joriy qiymat ig_comments.sentiment da.
  Xodim tuzatishlari — keyin AI sifatini o'lchash uchun (sales_ai baholash to'plamiga anonim holda). RLS (FORCE).
  '''
}

// ---------------------------------------------------------------------
// Javoblar
// ---------------------------------------------------------------------

Table messaging.ig_comment_replies {
  id uuid [pk]
  shop_id uuid [not null]
  comment_id uuid [not null]
  kind messaging.ig_reply_kind [not null]
  status messaging.ig_reply_status [not null]
  template_key text [note: 'PRIVATE_AUTO: customer.ig_comment_price_reply | customer.ig_comment_generic_reply']
  template_version text
  locale text [note: 'uz | ru | en — izoh tilidan, bo\'lmasa shop standarti']
  body text [note: 'Yuborilgan / qoralama matni (narx — CatalogQueryPort dan, javob paytida)']
  variables jsonb [not null, default: '{}', note: 'product_title, price, stock_line, product_url — PII yo\'q']
  skip_reason text [note: 'FLAG_OFF | AUTO_REPLY_OFF | POST_AUTO_REPLY_OFF | WINDOW_EXPIRED | AUTHOR_ALREADY_REPLIED | OWN_ACCOUNT | CHANNEL_DISCONNECTED | COMMENT_DELETED']
  intent_key text [not null, note: 'ig_auto:{comment_id} | ig_staff:{Idempotency-Key} | ig_draft:{comment_id}']
  provider_message_id text [note: 'Meta javob id\'si — xaridor Direct\'da javob bersa reply_to shu bilan suhbatga bog\'lanadi']
  ai_draft boolean [not null, default: false, note: 'Matnni AI tayyorlagan (salbiy izoh qoralamasi)']
  author_membership_id uuid [note: 'Xodim javobi / qoralamani tasdiqlagan']
  attempts int [not null, default: 0]
  last_error_code text [note: 'Adapter taksonomiyasi (13 §2) — matnsiz']
  sent_at timestamptz
  failed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  version bigint [not null, default: 1]

  indexes {
    (shop_id, id) [unique]
    (shop_id, intent_key) [unique, note: 'Bitta niyat bir marta yuboriladi']
    (shop_id, comment_id) [unique, note: 'Partial: WHERE kind IN (PRIVATE_AUTO, PRIVATE_STAFF) AND status NOT IN (SKIPPED, DISCARDED, FAILED) — bir izohga bitta Direct xabar (Meta)']
    (shop_id, provider_message_id) [note: 'Direct javobini izohga bog\'lash']
    (shop_id, status, created_at) [note: 'Qoralamalar va xatolar ro\'yxati']
  }
  Note: '''
  Izohga javoblar: Direct'ga (Private Reply, bir izohga bitta, 7 kun ichida) va ommaviy (faqat xodim).
  Javob messaging.messages ga yozilmaydi: Private Reply paytida xaridorning Direct id'si (IGSID) hali noma'lum.
  Xaridor javob yozsa — oddiy Direct suhbati yaratiladi (24 soat oynasi, BL-033), reply_to = provider_message_id orqali
  ig_comments.conversation_id to'ldiriladi va inbox'da "izohdan" belgisi bilan izoh + javob ko'rinadi.
  RLS (FORCE).
  '''
}

// ---------------------------------------------------------------------
// messaging.dbml ga ta'sir (migratsiyada qo'shiladi; instagram_comments.md §7)
// ---------------------------------------------------------------------
// 1. provider_events.ig_comment_id uuid NULL — COMMENT turidagi event qaysi izohni yaratdi (message_id o'rniga).
// 2. channel_accounts.settings.comments — {auto_reply, sentiment}; scopes'da izohlar ruxsati bo'lmasa flag yoqilmaydi.
// 3. platform.llm_purpose ga COMMENT_CLASSIFY (sales_ai.dbml).
// 4. platform.staff_tasks.type: IG_NEGATIVE_COMMENT (menejer), IG_REPLY_FAILED.
// 5. ChannelPort yonida InstagramCommentsPort: parse_comment_events, send_private_reply, send_public_reply, fetch_media.

// ---------------------------------------------------------------------
// Bog'lanishlar
// ---------------------------------------------------------------------

Ref: messaging.ig_posts.(shop_id, channel_account_id) > messaging.channel_accounts.(shop_id, id) [delete: restrict]
Ref: messaging.ig_post_products.(shop_id, post_id) > messaging.ig_posts.(shop_id, id) [delete: cascade]
Ref: messaging.ig_comments.(shop_id, post_id) > messaging.ig_posts.(shop_id, id) [delete: restrict]
Ref: messaging.ig_comments.(shop_id, channel_account_id) > messaging.channel_accounts.(shop_id, id) [delete: restrict]
Ref: messaging.ig_comment_sentiments.(shop_id, comment_id) > messaging.ig_comments.(shop_id, id) [delete: cascade]
Ref: messaging.ig_comments.(shop_id, sentiment_id) > messaging.ig_comment_sentiments.(shop_id, id)
Ref: messaging.ig_comment_replies.(shop_id, comment_id) > messaging.ig_comments.(shop_id, id) [delete: restrict]

TableGroup instagram_izohlar {
  messaging.ig_posts
  messaging.ig_post_products
  messaging.ig_comments
  messaging.ig_comment_sentiments
  messaging.ig_comment_replies
}
